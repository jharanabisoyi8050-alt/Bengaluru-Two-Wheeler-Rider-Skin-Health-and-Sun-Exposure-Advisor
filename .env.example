# ============================================================
# Bengaluru Two-Wheeler Rider Skin Health & Sun Exposure Advisor
# Environment Variables — copy to .env and fill in real values
# ============================================================

# --- IBM watsonx.ai (Granite LLM) ---
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# --- Groq (Fallback LLM) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=llama-3.3-70b-versatile

# --- Google Gemini (Secondary Fallback) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash

# --- MySQL / IBM Cloud Databases for MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=bengaluru_rider_advisor

# --- Application Settings ---
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# --- Open-Meteo API (Free, no key required, but can pin base URL) ---
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_AQI_URL=https://air-quality-api.open-meteo.com/v1

# --- LLM Cost Monitoring (USD per 1K tokens) ---
GRANITE_COST_PER_1K_TOKENS=0.00008
GROQ_COST_PER_1K_TOKENS=0.00006
GEMINI_COST_PER_1K_TOKENS=0.00010

# --- Security ---
API_SECRET_KEY=change_this_to_a_long_random_secret_string
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# --- Human-in-the-Loop Webhook (optional) ---
HITL_WEBHOOK_URL=
HITL_RISK_THRESHOLD=15.0
